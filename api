local Busy = false

local function VerifyKey()
    if Busy then
        return
    end

    if Box.Text ~= VALID_KEY then
        Status.Text = "Invalid key!"
        Status.TextColor3 = Color3.fromRGB(255, 75, 75)
        return
    end

    Busy = true
    Verify.Text = "VERIFYING..."
    Status.Text = "Saving key..."
    Status.TextColor3 = Color3.fromRGB(255, 200, 90)

    if not SaveKey() then
        Busy = false
        Verify.Text = "VERIFY KEY"
        Status.Text = "Cannot save key on this executor"
        Status.TextColor3 = Color3.fromRGB(255, 75, 75)
        return
    end

    Status.Text = "Key accepted!"
    Status.TextColor3 = Color3.fromRGB(90, 230, 130)

    task.wait(0.35)
    ScreenGui:Destroy()

    RunMainScript()
end

Verify.MouseButton1Click:Connect(VerifyKey)

Box.FocusLost:Connect(function(EnterPressed)
    if EnterPressed then
        VerifyKey()
    end
end)
