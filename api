local VALID_KEY = "PVkeyVLN-2957140-RTCLI-Client"
local SAVE_FILE = "PVclient.txt"

--==================================================
-- EXECUTOR FILE CHECK
--==================================================

local function HasSavedKey()
    if type(isfile) ~= "function"
        or type(readfile) ~= "function" then
        return false
    end

    local success, result = pcall(function()
        return isfile(SAVE_FILE)
            and readfile(SAVE_FILE) == VALID_KEY
    end)

    return success and result == true
end

local function SaveKey()
    if type(writefile) ~= "function" then
        return false
    end

    local success = pcall(function()
        writefile(SAVE_FILE, VALID_KEY)
    end)

    return success
end

--==================================================
-- RUN MAIN SCRIPT
--==================================================

local function RunMainScript()
    local URL = "https://raw.githubusercontent.com/indnoname/main/refs/heads/main/aimblox"
    local success, result = pcall(function()
        return game:HttpGet(URL)
    end)

    if not success then
        warn("โหลดโค้ดไม่สำเร็จ:", result)
        return
    end
    if type(result) ~= "string" or result == "" then
        warn("ไม่พบโค้ดที่ URL")
        return
    end

    warn("ดาวน์โหลดโค้ดสำเร็จ แต่ยังไม่ได้รัน")
end

if HasSavedKey() then
    RunMainScript()
    return
end

